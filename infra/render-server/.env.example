PORT=8080
RENDER_SERVER_SHARED_SECRET=
N8N_RENDER_CALLBACK_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

RENDER_WIDTH=3840
RENDER_HEIGHT=2160
RENDER_FPS=30
# Parallel frame workers. Leave unset on the render VM to use the CPU count.
# Cap it on memory-constrained hosts: each worker holds a full frame buffer and
# a 4K frame is ~33MB before encoding.
RENDER_CONCURRENCY=

CHANNEL_NAME=NationScope
ACCENT_COLOR=#e11d2e

# Must stay false/unset outside the actual GCE render VM — see src/shutdown.ts.
ENABLE_SELF_SHUTDOWN=false
IDLE_SHUTDOWN_AFTER_MS=300000

NODE_ENV=development
LOG_LEVEL=info
