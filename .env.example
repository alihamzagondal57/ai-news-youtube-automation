# ── LLM providers ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── Trend research ───────────────────────────────────────────
FIRECRAWL_API_KEY=

# ── Stock media ──────────────────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Voiceover / captions ─────────────────────────────────────
# Both run fully self-hosted on CPU: no API key, no egress, no rate limit.
#
# Voiceover uses Kokoro-82M (Apache-2.0). VOICEOVER_ENGINE=auto|kokoro|sapi.
# Leave unset for `auto`, which runs each voice on its own engine.
#
# Captions use Whisper via transformers.js. WHISPER_MODEL is a HuggingFace repo
# id — NOT a faster-whisper size name. base.en is the CPU sweet spot for our
# clean synthetic narration; larger checkpoints are markedly slower for little
# gain here. (Bare size names like "medium" are translated with a warning.)
WHISPER_MODEL=Xenova/whisper-base.en

# ── Shared object storage (job artifacts passed between steps) ─
# Cloudflare R2 (S3-compatible), used because GitHub Actions runners
# are stateless and the render VM needs to pull job inputs/outputs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ai-news-pipeline
R2_ENDPOINT=
# Path-style addressing (endpoint/bucket/key). Leave false for real R2; set true
# only for a localhost S3 mock (e.g. the s3rver-backed .smoke-test).
R2_FORCE_PATH_STYLE=false

# ── YouTube Data API v3 ──────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ── Render VM (Google Compute Engine, started on demand) ─────
RENDER_SERVER_URL=
RENDER_SERVER_SHARED_SECRET=
GCP_PROJECT_ID=
GCP_ZONE=europe-west4-a
GCP_INSTANCE_NAME=render-vm
# Service-account JSON key (roles/compute.instanceAdmin.v1), used only by
# GitHub Actions to start the VM — never needed by render-server itself.
GCP_SA_KEY=

# ── n8n ───────────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# ── GitHub (for n8n to trigger workflow_dispatch / repository_dispatch) ─
GITHUB_TOKEN=
GITHUB_REPO=

# ── Misc ──────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
