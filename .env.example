# ── LLM providers ─────────────────────────────────────────────
# See services/script-generator/src/providers/registry.ts for the full
# catalog (rank, cost, how-to-get-key, and — for disabled ones — exactly why).
ANTHROPIC_API_KEY=
# GitHub Models was permanently retired 2026-07-30 — this var is read by
# nothing usable (registry.ts's entry is disabled for good). Leave unset.
GITHUB_MODELS_TOKEN=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
# Disabled in registry.ts (operational, not auth) — set only for
# qualify-providers.mts re-testing.
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ── Trend research ───────────────────────────────────────────
FIRECRAWL_API_KEY=

# ── Stock media ──────────────────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Thumbnail background image (FLUX.1 [schnell] via Hugging Face) ──
# Optional on purpose — thumbnail-generator runs on the free monthly credit
# only (no payment method configured, see docs/LICENSING.md §3.6) and falls
# back to a real render.mp4 frame / the theme's own gradient when this is
# unset or the credit is exhausted. A fine-grained User Access Token with
# "Make calls to Inference Providers" permission: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# ── Voiceover / captions ─────────────────────────────────────
# Both run fully self-hosted on CPU: no API key, no egress, no rate limit.
#
# Voiceover uses Kokoro-82M (Apache-2.0). VOICEOVER_ENGINE=auto|kokoro|sapi.
# Leave unset for `auto`, which runs each voice on its own engine.
#
# Captions use Whisper via transformers.js. WHISPER_MODEL is a HuggingFace repo
# id — NOT a faster-whisper size name. base.en is the CPU sweet spot for our
# clean synthetic narration; larger checkpoints are markedly slower for little
# gain here. (Bare size names like "medium" are translated with a warning.)
WHISPER_MODEL=Xenova/whisper-base.en

# ── Shared object storage (job artifacts passed between steps) ─
# Cloudflare R2 (S3-compatible), used because GitHub Actions runners
# are stateless and the render VM needs to pull job inputs/outputs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ai-news-pipeline
R2_ENDPOINT=
# Path-style addressing (endpoint/bucket/key). Leave false for real R2; set true
# only for a localhost S3 mock (e.g. the s3rver-backed .smoke-test).
R2_FORCE_PATH_STYLE=false

# ── YouTube Data API v3 ──────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ── Render VM (Google Compute Engine, started on demand) ─────
RENDER_SERVER_URL=
RENDER_SERVER_SHARED_SECRET=
# Interim (2026-08): default is 1080p (infra/render-server/src/config.ts) while
# the GCE render VM's billing is being sorted — 4K renders too slowly on a
# local desktop CPU to be practical. Uncomment to render 4K (e.g. once back on
# the render VM, or on capable local hardware) — leave unset for 1080p.
# RENDER_WIDTH=3840
# RENDER_HEIGHT=2160
GCP_PROJECT_ID=
GCP_ZONE=europe-west4-a
GCP_INSTANCE_NAME=render-vm
# Service-account JSON key (roles/compute.instanceAdmin.v1), used only by
# GitHub Actions to start the VM — never needed by render-server itself.
GCP_SA_KEY=

# ── n8n ───────────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
# review-dashboard's approve endpoint POSTs review-state.json here (n8n's
# release-on-approval.json workflow's webhook trigger URL) so n8n can resume
# and run youtube-uploader. Optional — approve/reject work without it; there's
# just nothing to notify. See apps/review-dashboard/server/src/n8nWebhook.ts.
N8N_APPROVAL_WEBHOOK_URL=
# Read by n8n itself (its own process env, not this repo's services) inside
# n8n/workflows/shared-error-handling.json — point it at a Slack incoming
# webhook, a Telegram bot's sendMessage URL, or similar. Optional: unset just
# means job.json still gets marked failed, with nothing sent anywhere.
N8N_ERROR_NOTIFY_WEBHOOK_URL=

# ── GitHub (for n8n to trigger workflow_dispatch / repository_dispatch) ─
GITHUB_TOKEN=
GITHUB_REPO=

# ── Misc ──────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
