# ── LLM providers ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── Trend research ───────────────────────────────────────────
FIRECRAWL_API_KEY=

# ── Stock media ──────────────────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Voiceover / captions ─────────────────────────────────────
# Edge-TTS needs no key (uses Microsoft's public edge endpoint).
# Whisper: set WHISPER_MODEL to a local model size (tiny/base/small/medium/large-v3)
# or leave blank to run via the OpenAI-compatible Whisper API instead.
WHISPER_MODEL=medium
OPENAI_API_KEY=

# ── Shared object storage (job artifacts passed between steps) ─
# Cloudflare R2 (S3-compatible), used because GitHub Actions runners
# are stateless and the render VM needs to pull job inputs/outputs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ai-news-pipeline
R2_ENDPOINT=

# ── YouTube Data API v3 ──────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ── Render VM (Oracle Cloud) ─────────────────────────────────
RENDER_SERVER_URL=
RENDER_SERVER_SHARED_SECRET=

# ── n8n ───────────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# ── GitHub (for n8n to trigger workflow_dispatch / repository_dispatch) ─
GITHUB_TOKEN=
GITHUB_REPO=

# ── Misc ──────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
