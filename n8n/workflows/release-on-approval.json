        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { dispatchedAt: new Date().toISOString() } }];"
      },
      "id": "11111111-0000-0000-0000-000000000011",
      "name": "Stamp: youtube-uploader",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
