{
  "name": "Release on Approval",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "release-on-approval",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "11111111-0000-0000-0000-000000000001",
      "name": "On approval webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "release-on-approval"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const state = $input.first().json.body;\nif (state.status !== 'approved') throw new Error(`release-on-approval got a non-approved state for job ${state.jobId}: status=${state.status}`);\nconst payload = { jobId: state.jobId, mode: 'manual', status: 'running', currentStep: 'youtube-uploader', niche: 'news-europe' };\nreturn [{ json: { jobId: state.jobId, updateJobB64: Buffer.from(JSON.stringify(payload)).toString('base64') } }];"
      },
      "id": "11111111-0000-0000-0000-000000000002",
      "name": "Build: youtube-uploader",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "command": "=cd /d \"E:\\Youtube Ai Automation Agent\" && npx tsx n8n/scripts/update-job.mts \"{{ $json.updateJobB64 }}\""
      },
      "id": "11111111-0000-0000-0000-000000000003",
      "name": "job.json: youtube-uploader",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { jobId: $('Build: youtube-uploader').first().json.jobId } }];"
      },
