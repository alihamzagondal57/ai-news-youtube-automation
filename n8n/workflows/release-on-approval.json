        "command": "=cd /d \"E:\\Youtube Ai Automation Agent\" && npx tsx services/youtube-uploader/src/index.ts \"{{ $('Build: youtube-uploader').first().json.jobId }}\""
      },
      "id": "11111111-0000-0000-0000-000000000004",
      "name": "Run youtube-uploader",
