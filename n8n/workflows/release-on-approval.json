        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ref: 'master', inputs: { jobId: $('Job Context').first().json.jobId } }) }}",
        "options": {}
      },
      "id": "11111111-0000-0000-0000-000000000010",
