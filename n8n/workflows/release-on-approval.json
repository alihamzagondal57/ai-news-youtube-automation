        "url": "=https://api.github.com/repos/{{ $env.GITHUB_REPO }}/actions/workflows/08-upload-youtube.yml/dispatches",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
