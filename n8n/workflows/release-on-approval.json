    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $env.GITHUB_REPO }}/actions/workflows/08-upload-youtube.yml/runs?event=workflow_dispatch&per_page=5",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "11111111-0000-0000-0000-000000000013",
      "name": "Find run: youtube-uploader",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const dispatchedAt = new Date($('Stamp: youtube-uploader').first().json.dispatchedAt).getTime();\nconst runs = ($json.workflow_runs || []).filter(r => new Date(r.created_at).getTime() >= dispatchedAt - 5000);\nruns.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\nconst run = runs[0] || null;\nconst stillWaiting = !run || run.status !== 'completed';\nconst succeeded = !!run && run.status === 'completed' && run.conclusion === 'success';\nreturn [{ json: { stillWaiting, succeeded, runId: run ? run.id : null, htmlUrl: run ? run.html_url : null, conclusion: run ? run.conclusion : null } }];"
      },
      "id": "11111111-0000-0000-0000-000000000014",
      "name": "Eval run: youtube-uploader",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.stillWaiting }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "11111111-0000-0000-0000-000000000015",
      "name": "Still waiting? youtube-uploader",
