{
  "name": "@ai-news/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./theme": { "types": "./dist/theme/index.d.ts", "default": "./dist/theme/index.js" },
    "./src/theme": { "types": "./src/theme/index.ts", "default": "./src/theme/index.ts" },
    "./script-structure": { "types": "./dist/script-structure/index.d.ts", "default": "./dist/script-structure/index.js" },
    "./src/script-structure": { "types": "./src/script-structure/index.ts", "default": "./src/script-structure/index.ts" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.616.0",
    "@aws-sdk/s3-request-presigner": "^3.616.0",
    "pino": "^9.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.13",
    "pino-pretty": "^11.2.2",
    "typescript": "^5.5.4"
  }
}
