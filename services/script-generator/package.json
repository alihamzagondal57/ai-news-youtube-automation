{
  "name": "@ai-news/script-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./providers/registry": { "types": "./dist/providers/registry.d.ts", "default": "./dist/providers/registry.js" },
    "./providers/types": { "types": "./dist/providers/types.d.ts", "default": "./dist/providers/types.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-news/shared": "*",
    "@anthropic-ai/sdk": "^0.112.4",
    "dotenv": "^16.4.5",
    "openai": "^6.48.0",
    "zod": "^3.23.8",
    "@google/genai": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.13",
    "typescript": "^5.5.4"
  }
}
